# Required for the default X API read provider
X_BEARER_TOKEN=

# Optional Xquik read provider for get_tweet and search_tweets
XQUIK_API_KEY=
XQUIK_BASE_URL=https://xquik.com/api/v1

# Required for write operations (post, like, retweet, delete)
# From developer.x.com -> App -> OAuth 2.0 settings
X_CLIENT_ID=
X_CLIENT_SECRET=

# Run "npm run get-token" to get this (one-time OAuth 2.0 PKCE flow)
X_REFRESH_TOKEN=
