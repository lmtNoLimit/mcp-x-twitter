# Required — from developer.x.com → App → Keys and Tokens
X_BEARER_TOKEN=

# Required for write operations (post, like, retweet, delete)
# From developer.x.com → App → OAuth 2.0 settings
X_CLIENT_ID=
X_CLIENT_SECRET=

# Run "npm run get-token" to get this (one-time OAuth 2.0 PKCE flow)
X_REFRESH_TOKEN=
